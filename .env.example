# ── Copy to .env and fill in. Never commit .env. ─────────────────

NODE_ENV=development
PORT=3000
# Public origin, used in verification links and email footers
APP_URL=http://localhost:3000

# ── MongoDB Atlas ────────────────────────────────────────────────
# Atlas > Connect > Drivers. Whitelist your host's IP (0.0.0.0/0 for Render).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/jobwire?retryWrites=true&w=majority
MONGODB_DB=jobwire

# ── Sessions ─────────────────────────────────────────────────────
# Any long random string. Changing it signs everyone out.
SESSION_SECRET=change-me-to-something-long-and-random

# ── Gmail ────────────────────────────────────────────────────────
# NOT your Gmail password. Google Account > Security > 2-Step
# Verification (must be on) > App passwords > generate a 16-char one.
# Limit is ~500 messages/day on free Gmail.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=Job Wire <you@gmail.com>

# ── Poller ───────────────────────────────────────────────────────
# How often the loop wakes to look for due queries (seconds).
POLL_TICK_SECONDS=30
# Default sweep interval for a new watch (minutes).
DEFAULT_SWEEP_MINUTES=5
# Never sweep faster than this, whatever the user picks (minutes).
MIN_SWEEP_MINUTES=2
# Random delay added before each LinkedIn request (ms) so the
# cadence does not look robotic.
FETCH_JITTER_MS=4000
# Consecutive failures before a query is parked.
MAX_FAIL_COUNT=6

# ── Feature flags ────────────────────────────────────────────────
# Set false to run the web app without the poller (useful locally).
POLLER_ENABLED=true
