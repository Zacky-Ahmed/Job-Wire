# Copy to .env; never commit credentials. Migration defaults keep workers off.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:3000
# Number of trusted reverse-proxy hops; 0 for direct local HTTP.
TRUST_PROXY_HOPS=1
# DNS result ordering: "verbatim" (default), "ipv4first" for hosts without IPv6.
DNS_RESULT_ORDER=verbatim

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/jobwire?retryWrites=true&w=majority
MONGODB_DB=jobwire
SESSION_SECRET=replace-with-at-least-32-random-characters

# ── Mail ──────────────────────────────────────────────────────────────────────
# Set false for read-only staging; no mail credentials required then.
MAIL_ENABLED=true
# Use Brevo HTTPS API, OR Gmail SMTP when host permits outbound SMTP.
BREVO_API_KEY=
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=Job Wire <you@gmail.com>
ADMIN_EMAILS=
GOOGLE_SITE_VERIFICATION=

# ── Poller ────────────────────────────────────────────────────────────────────
# Start only after checking source permissions and stopping the old worker.
POLLER_ENABLED=false
SOURCES_DISABLED=linkedin
POLL_TICK_SECONDS=30
DELIVERY_TICK_SECONDS=15
DEFAULT_SWEEP_MINUTES=5
MIN_SWEEP_MINUTES=5
# Burst spreading only — not an identity-evasion mechanism.
FETCH_JITTER_MS=4000
MAX_FAIL_COUNT=6
SHUTDOWN_GRACE_MS=120000

# ── LinkedIn source policy ────────────────────────────────────────────────────
# Operator attestation that written LinkedIn authorization or a licensed
# arrangement covers the intended collection. NOT a technical permission grant.
# Keep false until the separate prerequisites are satisfied; see docs/MIGRATION-RUNBOOK.md.
LINKEDIN_ACCESS_CONFIRMED=false
# Deployment-wide HTTP transaction ceiling (incl. redirects). Conservative default;
# any authorized integration limit overrides it downward. Do not raise to defeat a block.
LINKEDIN_REQUEST_BUDGET_PER_HOUR=300
# Exponential circuit breaker: first 403/429 pauses for BACKOFF_MINUTES,
# each subsequent block doubles the pause, capped at BACKOFF_MAX_MINUTES (=24h).
LINKEDIN_BLOCKED_BACKOFF_MINUTES=60
LINKEDIN_BLOCKED_BACKOFF_MAX_MINUTES=1440

# ── Outbound identity ────────────────────────────────────────────────────────
# Honest application identifier. Leave blank for the default: JobWire/0.1 (+APP_URL)
OUTBOUND_USER_AGENT=

# ── Data retention ────────────────────────────────────────────────────────────
SEEN_JOB_TTL_DAYS=14
ALERT_TTL_DAYS=1095
STALE_ALERT_DAYS=90
STARTER_WATCH_KEYWORDS=intern
STARTER_WATCH_GEO_ID=100446352
STARTER_WATCH_LABEL=Intern
