<%# admin/health.ejs
     Is the poller alive, and is each board answering.

     Split out of pages/admin.ejs so it can be re-rendered on its own.
     The wrapper carries the id the fragment route replaces and the
     events that tell it to: a mutation announces what it changed, and
     only the panels that care come and fetch it. Nothing polls. %>
<div id="admin-health" hx-get="/admin/fragments/health"
  hx-trigger="admin:pollerChanged from:body" hx-target="this" hx-swap="outerHTML">
  <%# Liveness and per-source health. Both were previously reported from
      configuration rather than evidence: "Poller: Running" meant
      POLLER_ENABLED was true, and a query showed healthy whenever any one
      of its sources answered. %>
  <div class="panel">
    <div class="panel-h">
      <span class="dot <%= (!poller.configured || poller.stale || poller.never) ? 'sig' : 'live' %>"></span>
      <h3>Poller</h3>
      <span class="sp"></span>
      <span class="lbl">measured, not configured</span>
    </div>
    <div class="row r-admin">
      <div class="role">
        <%# One snapshot decides the wording, so this row cannot
            contradict the chip in the shell or the tile above it. It
            did: "Sweeping" up there, "Stalled" on the tile, "standby"
            here and "Not ticking" in the pill, on one page load. %>
        <div class="a"><%= poller.detail %></div>
        <div class="b">
          state <%= poller.state %><% if (poller.queueDepth !== null) { %> ·
          queue <%= poller.queueDepth %><% if (poller.dueTotal && poller.dueTotal > poller.queueDepth) { %>
          of <%= poller.dueTotal %> due<% } %><% } %><% if (poller.lastTickMs !== null) { %> ·
          last pass <%= (poller.lastTickMs / 1000).toFixed(1) %>s<% } %><% if (poller.progressAgeSec !== null) { %> ·
          progress <%= poller.progressAgeSec %>s ago<% } %>
        </div>
      </div>
      <span>
        <%# The pill says what the snapshot says. "Not ticking" used to
            fire on STANDBY, which is a healthy state meaning another
            process holds the crawl lease. %>
        <span class="pill <%= poller.tone === 'go' ? 'go' : poller.tone === 'amber' ? 'off' : 'sig' %>"><%= poller.label %></span>
      </span>
      <span class="muted hide"></span><span class="muted hide"></span>
    </div>
  </div>

  <div class="panel">
    <div class="panel-h">
      <span class="dot <%= sourceHealth.some(h => !h.ok) ? 'sig' : 'live' %>"></span>
      <h3>Sources</h3>
      <span class="sp"></span>
      <span class="lbl">last result per board</span>
    </div>
    <% if (!sourceHealth.length) { %>
      <div class="row r-admin"><div class="role"><div class="b">
        No sweep has recorded source health yet.</div></div>
        <span></span><span class="muted hide"></span><span class="muted hide"></span></div>
    <% } %>
    <% sourceHealth.forEach(function (h) { %>
      <div class="row r-admin">
        <div class="role">
          <div class="a"><%= h.source %></div>
          <%# The verdict is the newest snapshot, so its age belongs next
              to it: "answered", four days stale, is not reassurance. %>
          <div class="b"><%= h.ok ? "answered" : (h.error || "failed") %> · <%= h.seen %><%
            if (h.failing) { %> · failing in <%= h.failing %> of <%= h.total %> search<%= h.total === 1 ? "" : "es" %><% } %></div>
        </div>
        <span>
          <% if (h.ok) { %><span class="pill go">OK</span>
          <% } else { %><span class="pill sig">Failing</span><% } %>
        </span>
        <span class="muted hide"></span><span class="muted hide"></span>
      </div>
    <% }); %>
  </div>
</div>
