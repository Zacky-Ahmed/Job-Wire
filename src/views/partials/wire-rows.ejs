<% if (!dispatches.length) { %>
  <div class="empty">
    <span class="ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2" stroke-linecap="round"><path d="M12 21v-9"/>
      <path d="M5 12a9 9 0 0 1 14 0"/><circle cx="12" cy="8" r="1.6" fill="currentColor"/></svg></span>
    <%# "The wire is sweeping" was printed even with no watches at all,
        which told a brand-new user to wait for something that was never
        going to happen. %>
    <% if (typeof watchCount !== 'undefined' && !watchCount) { %>
      <b>No watches yet</b>
      <span>Nothing is being swept. Create a watch and postings land here
        as they appear.</span>
      <a class="btn btn-sig" href="/watches?new=1" style="margin-top:8px">Create your first watch</a>
    <% } else { %>
      <b>Nothing caught yet</b>
      <span>The wire is sweeping. New postings land here the moment they appear
        in LinkedIn's search index.</span>
    <% } %>
  </div>
<% } else { %>
  <% dispatches.forEach(function (d, i) { %>
    <div class="row r-wire<%= d.isNew ? ' new' : '' %>">
      <span class="ix c-ix"><%= String(dispatches.length - i).padStart(3, '0') %></span>
      <span class="c-mail">
        <% if (d.emailed) { %><span class="pill go">Sent</span>
        <% } else if (d.failed) { %><span class="pill sig" title="Delivery failed — the next sweep retries">Failed</span>
        <% } else { %><span class="pill off">—</span><% } %>
      </span>
      <div class="role">
        <div class="a"><%= d.title %>
          <%# "keyword" is the placeholder rows got while sweep was
              discarding refine's verdict — it explains nothing, so it
              earns no badge. %>
          <% if (d.matchedBy && d.matchedBy !== 'title' && d.matchedBy !== 'keyword') { %>
            <span class="why" title="Its title does not mention your keyword. It is here because the employer tagged it this way — which is exactly what your LinkedIn filter goes on, spam included."><%= d.matchedBy %> tag</span>
          <% } %>
        </div>
        <div class="b"><%= d.company %><%= d.location ? ' · ' + d.location : '' %></div>
      </div>
      <span class="muted hide c-watch"><span class="pill vio"><%= d.label %></span></span>
      <span class="muted hide c-age"><%= d.ageText %></span>
      <div class="hide c-win">
        <span class="lbl"><%= d.windowLeft ? '~' + d.windowLeft + 'm left' : 'likely closed' %></span>
        <div class="gauge"><i class="<%= d.windowClass %>" style="width:<%= d.windowPct %>%"></i></div>
      </div>
      <div class="acts c-act">
        <a class="btn btn-xs btn-sig" href="<%= d.url %>" target="_blank" rel="noopener noreferrer">Apply</a>
      </div>
    </div>
  <% }) %>
<% } %>
