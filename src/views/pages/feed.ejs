<div class="wrap design-feed" hx-boost="true" hx-target="#workspaceMain" hx-swap="innerHTML show:window:top" hx-sync="#workspaceMain:replace">
<div class="summary-strip"><div><strong><%= total %></strong><small><%= isSaved?'saved opportunities':'matching opportunities' %></small></div><div><small><%= isSaved?'Your shortlist stays until you remove it':'Collected history lasts 14 days' %></small></div><a class="link" href="/interests">Tune your email interests ↗</a></div>
<div class="design-layout"><section class="panel"><form class="toolbar" hx-push-url="true" method="get" action="<%= isSaved?'/saved':'/wire' %>">
<label class="search"><input type="search" name="q" value="<%= f.q %>" placeholder="Search role, company or location…" aria-label="Search jobs"></label>
<select name="source" aria-label="Source"><option value="">All sources</option><% for(const {id,label} of sourceOptions) { %><option value="<%= id %>" <%= f.source===id?'selected':'' %>><%= label %></option><% } %></select>
<select name="range" aria-label="Date window"><option value="14d"><%= isSaved?'All saved jobs':'Collected · 14 days' %></option><option value="24h" <%= f.range==='24h'?'selected':'' %>>Posted · 24 hours</option></select>
<select name="sort" aria-label="Sort"><option value="newest">Newest first</option><option value="oldest" <%= f.sort==='oldest'?'selected':'' %>>Oldest first</option></select><label class="match-toggle"><input type="checkbox" name="match" value="yes" <%= f.match?'checked':'' %>> For my interests</label><button class="btn btn-sig">Filter</button><a class="btn" href="<%= isSaved?'/saved':'/wire' %>">Reset</a></form>
<div id="newJobsNotice" class="note" hidden>New jobs are available. <a href="/wire">Refresh the Wire</a></div>
<% if(!jobs.length){ %><div class="empty"><b>No jobs here yet</b><span><%= isSaved?'Save a job from the Wire to start your shortlist.':'Try broader filters. New opportunities appear after a successful source check.' %></span></div><% } %>
<% jobs.forEach(j=>{ %><article class="job-card-row" data-job-detail="/wire/job/<%= j._id %>"><div class="company-letter" aria-hidden="true"><%= (j.company||'?').slice(0,1) %></div><div class="job-body"><a class="job-title" data-open-job hx-boost="false" href="/wire/job/<%= j._id %>"><%= j.title %></a><p><%= j.company %><%= j.location?' · '+j.location:'' %></p><div class="job-tags"><span><%= j.source %></span><span>Posted <%= j.posted %></span><% if(j.interest){ %><span class="interest-tag">Matches your interests</span><% } %></div><small>Collected <%= j.collected %> · Sri Lanka time</small></div><form class="save-job" hx-boost="false" method="post" action="/saved/<%= j.saveId %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= j.saved?'remove':'save' %>"><input type="hidden" name="returnTo" value="<%= isSaved?'/saved':'/wire' %>"><button class="btn" aria-label="<%= j.saved?'Unsave':'Save' %> <%= j.title %>" aria-pressed="<%= j.saved %>"><%= j.saved?'Saved ✓':'Save' %></button></form></article><% }) %>
<div class="feed-pagination"><span>Page <%= f.page %> of <%= pages %> · <%= total %> results</span><div><% if(f.page>1){ %><a class="btn" href="<%= href(f.page-1) %>">← Previous</a><% } %><% if(f.page<pages){ %><a class="btn" href="<%= href(f.page+1) %>">Next →</a><% } %></div></div></section>
<aside class="design-rail"><section class="panel"><div class="panel-h"><h3>Your email interests</h3></div><div class="rail-body"><% watches.forEach(w=>{const pref=preferenceFor(w); %><p><strong><%= pref.name || (pref.mode==='all'?'All collected roles':'Selected interests') %></strong><br><%= w.label %></p><% }) %><p>Your interests control emails. The full Wire stays available.</p><a class="link" href="/interests">Edit interests →</a></div></section><section class="panel"><div class="rail-body"><h3>Your feed isn’t your inbox.</h3><p>Finding a job, matching your preferences and provider acceptance are separate steps.</p><a class="link" href="/delivery">View your delivery history →</a><p><a class="link" href="/watches">Hold or resume your alerts →</a></p></div></section></aside></div></div>