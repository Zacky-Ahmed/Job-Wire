<%# The admin page is five panels that go stale for different reasons,
    so each is a partial the server can render on its own. What is left
    here is their order. %>
<%# Boosted for the forms only — there is not a single anchor inside
    these five panels, so nothing else is caught. Each mutation answers
    204 and a list of what it changed; htmx swaps nothing and the panels
    listening for those names fetch themselves. %>
<div class="wrap" hx-boost="true">
  <%- include('../partials/admin/overview') %>
  <%- include('../partials/admin/health') %>
  <%- include('../partials/admin/delivery') %>
  <%- include('../partials/admin/people') %>
  <%- include('../partials/admin/queries') %>
</div>
