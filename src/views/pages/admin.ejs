<div class="wrap">
  <% if (typeof adminError !== 'undefined' && adminError) { %>
    <div class="banner err"><%= adminError %></div>
  <% } %>
  <% if (typeof adminNotice !== 'undefined' && adminNotice) { %>
    <div class="banner go"><%= adminNotice %></div>
  <% } %>
  <div class="stats stagger">
    <div class="stat vio">
      <div class="k">People</div>
      <div class="v"><%= totals.users %></div>
      <div class="d"><%= totals.verified %> verified · <%= totals.unverified %> pending</div>
    </div>
    <div class="stat sig">
      <div class="k">Watches</div>
      <div class="v"><%= totals.watches %></div>
      <div class="d"><%= totals.queries %> shared queries behind them</div>
    </div>
    <%# Today, not a rolling 24 hours. The denominator is the provider's
        daily ceiling and the poller enforces it per calendar day, so a
        rolling numerator made this ratio unreadable: it could show 260 of
        280 spent while the poller had counted 40. %>
    <div class="stat <%= totals.failedToday ? 'amber' : 'go' %>">
      <div class="k">Mail · today</div>
      <div class="v"><%= totals.mailToday %> <span class="u">/<%= totals.mailCap %></span></div>
      <div class="d"><%= totals.failedToday %> failed · <%= totals.mailProvider %></div>
    </div>
    <%# Measured, not configured. This read POLLER_ENABLED, so it could
        print "Running" directly above a panel that said "Not ticking" on
        the same page load. Both now render one verdict from the
        heartbeat the loop writes itself. %>
    <div class="stat <%= poller.tone %>">
      <div class="k">Poller</div>
      <div class="v" style="font-size:26px"><%= poller.label %></div>
      <div class="d"><%= poller.detail %></div>
    </div>
  </div>

  <%# Liveness and per-source health. Both were previously reported from
      configuration rather than evidence: "Poller: Running" meant
      POLLER_ENABLED was true, and a query showed healthy whenever any one
      of its sources answered. %>
  <div class="panel">
    <div class="panel-h">
      <span class="dot <%= (!poller.configured || poller.stale || poller.never) ? 'sig' : 'live' %>"></span>
      <h3>Poller</h3>
      <span class="sp"></span>
      <span class="lbl">measured, not configured</span>
    </div>
    <div class="row r-admin">
      <div class="role">
        <div class="a">
          <% if (!poller.configured) { %>Disabled by POLLER_ENABLED
          <% } else if (poller.never) { %>No tick has ever been recorded
          <% } else if (poller.stale) { %><%= poller.detail %> — wedged
          <% } else if (poller.sweeping) { %>Sweeping now · started <%= poller.tickAgeSec %>s ago
          <% } else { %>Ticked <%= poller.tickAgeSec %>s ago<% } %>
        </div>
        <div class="b">
          state <%= poller.state %><% if (poller.queueDepth !== null) { %> ·
          queue <%= poller.queueDepth %><% } %><% if (poller.lastTickMs !== null) { %> ·
          last pass <%= (poller.lastTickMs / 1000).toFixed(1) %>s<% } %>
        </div>
      </div>
      <span>
        <% if (!poller.configured) { %><span class="pill off">Off</span>
        <% } else if (poller.stale || poller.never) { %><span class="pill sig">Not ticking</span>
        <% } else { %><span class="pill go"><%= poller.label %></span><% } %>
      </span>
      <span class="muted hide"></span><span class="muted hide"></span>
    </div>
  </div>

  <div class="panel">
    <div class="panel-h">
      <span class="dot <%= sourceHealth.some(h => !h.ok) ? 'sig' : 'live' %>"></span>
      <h3>Sources</h3>
      <span class="sp"></span>
      <span class="lbl">last result per board</span>
    </div>
    <% if (!sourceHealth.length) { %>
      <div class="row r-admin"><div class="role"><div class="b">
        No sweep has recorded source health yet.</div></div>
        <span></span><span class="muted hide"></span><span class="muted hide"></span></div>
    <% } %>
    <% sourceHealth.forEach(function (h) { %>
      <div class="row r-admin">
        <div class="role">
          <div class="a"><%= h.source %></div>
          <%# The verdict is the newest snapshot, so its age belongs next
              to it: "answered", four days stale, is not reassurance. %>
          <div class="b"><%= h.ok ? "answered" : (h.error || "failed") %> · <%= h.seen %><%
            if (h.failing) { %> · failing in <%= h.failing %> of <%= h.total %> search<%= h.total === 1 ? "" : "es" %><% } %></div>
        </div>
        <span>
          <% if (h.ok) { %><span class="pill go">OK</span>
          <% } else { %><span class="pill sig">Failing</span><% } %>
        </span>
        <span class="muted hide"></span><span class="muted hide"></span>
      </div>
    <% }); %>
  </div>

  <div class="panel">
    <div class="panel-h">
      <span class="dot <%= delivery.misaligned ? 'sig' : 'live' %>"></span>
      <h3>Delivery</h3>
      <span class="sp"></span>
      <span class="lbl">"sent" means accepted, not received</span>
    </div>
    <div class="row r-admin">
      <div class="role">
        <div class="a">Sending as <%= delivery.from %></div>
        <div class="b">via <%= delivery.provider %> · last accepted <%= delivery.lastSentAt %></div>
      </div>
      <span>
        <% if (delivery.misaligned) { %><span class="pill sig">DMARC broken</span>
        <% } else { %><span class="pill go">Aligned</span><% } %>
      </span>
      <span class="muted hide"></span><span class="muted hide"></span>
    </div>
    <% if (delivery.misaligned) { %>
      <div class="note" style="margin:12px 14px;border-radius:8px">
        <span><b><%= delivery.from %></b> is a freemail address being relayed through
          <%= delivery.provider %>. Only Google may send as gmail.com, so these messages
          claim a domain the relay cannot prove. Gmail accepts them and then files them
          in <b>Spam</b> — or drops them silently. That is why the provider reports
          0&nbsp;failed while nothing arrives.
          <br><br>
          The fix is a domain you own: register one, authenticate it in
          <%= delivery.provider %> with SPF and DKIM, and send as
          <b>alerts@yourdomain</b>. Until then, check Spam and mark the messages
          “Not spam”, which teaches Gmail for your own inbox only — new users
          signing up will still lose their verification codes.</span>
      </div>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-h">
      <span class="dot live"></span>
      <h3>People</h3>
      <span class="sp"></span>
      <%# The cap is a display limit. Saying what is shown out of what
          exists is the difference between "not on this page" and "gone". %>
      <span class="lbl">newest first · showing <%= totals.shown %> of <%= totals.users %></span>
    </div>
    <div class="row rhead r-admin">
      <span>Email</span><span>State</span><span class="hide">Watches</span><span style="text-align:right">Actions</span>
    </div>
    <% if (!people.length) { %>
      <div class="empty"><b>No accounts yet</b><span>Nobody has signed up.</span></div>
    <% } %>
    <% people.forEach(function (p) { %>
      <div class="row r-admin">
        <div class="role">
          <div class="a"><%= p.email %><% if (p.isAdmin) { %><span class="why">admin</span><% } %></div>
          <div class="b c-only">joined <%= p.joined %> · <%= p.watches %> watch<%= p.watches === 1 ? '' : 'es' %></div>
        </div>
        <span>
          <% if (p.verified) { %><span class="pill go">Verified</span>
          <% } else { %><span class="pill amber" title="Signed up but never entered the emailed code — they cannot sign in">Unverified</span><% } %>
        </span>
        <span class="muted hide"><%= p.active %>/<%= p.watches %></span>
        <div class="acts">
          <% if (!p.verified) { %>
            <%# The reason this exists: a verification code in a spam
                folder locks someone out of their own account with no way
                to help them from inside the app. %>
            <form method="post" action="/admin/users/<%= p.id %>/verify">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-xs" type="submit" title="Mark this address confirmed">Verify</button>
            </form>
          <% } %>
          <% if (!p.isAdmin) { %>
            <form method="post" action="/admin/users/<%= p.id %>/delete"
              <%# The address goes in a data- attribute, not inside a JS
                  string literal. o'brien@x.com is a valid address; EJS
                  escapes the quote to &#39;, the browser decodes it back
                  to ' while parsing the attribute, and the literal ends
                  early — a syntax error, so confirm() never ran and the
                  form submitted straight through. %>
              data-email="<%= p.email %>"
              onsubmit="return confirm('Delete ' + this.dataset.email + '? Their watches and mail history go too. This cannot be undone.')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-xs btn-bad" type="submit" aria-label="Delete account">Delete</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="panel">
    <div class="panel-h">
      <span class="dot <%= queryRows.some(q => q.orphaned || q.stalled) ? 'off' : 'live' %>"></span>
      <h3>Queries</h3>
      <span class="sp"></span>
      <span class="lbl">what the poller is actually doing</span>
    </div>
    <div class="row rhead r-admin">
      <span>Search</span><span>State</span><span class="hide">Seen</span><span style="text-align:right">Actions</span>
    </div>
    <% if (!queryRows.length) { %>
      <div class="empty"><b>No queries</b><span>Nothing is being swept.</span></div>
    <% } %>
    <% queryRows.forEach(function (q) { %>
      <div class="row r-admin">
        <div class="role">
          <div class="a"><%= q.label %><% if (q.matchAll) { %><span class="why">everything</span><% } %></div>
          <div class="b"><%= q.location %> · <%= q.sources %> · every <%= q.every %> min</div>
          <%# Who is on it. A count answers the wrong question: before
              parking or deleting a search you want to know whose it is. %>
          <div class="watchers">
            <% if (!q.watchers.length) { %>
              <span class="w-none">nobody is watching this</span>
            <% } %>
            <% q.watchers.forEach(function (w) { %>
              <span class="w-one<%= w.active ? '' : ' held' %>"
                title="<%= w.active ? 'Watching' : 'Paused by them' %>">
                <%= w.email %><span class="w-lbl"><%= w.label %></span>
              </span>
            <% }) %>
          </div>
        </div>
        <span>
          <% if (q.retired) { %><span class="pill off" title="Nobody watches this any more, so it has stopped sweeping">Parked</span>
          <% } else if (q.orphaned) { %><span class="pill sig" title="No subscribers, but still sweeping — this is wasted budget">Orphaned</span>
          <% } else if (q.stalled) { %><span class="pill sig" title="Overdue by <%= q.overdueMin %> min">Stalled</span>
          <% } else if (q.failCount) { %><span class="pill amber"><%= q.failCount %> fails</span>
          <% } else { %><span class="pill go">Healthy</span><% } %>
        </span>
        <span class="muted hide tnum" title="last sweep / best ever">
          <%= q.tracked %><span class="lbl">/<%= q.peak %></span>
        </span>
        <div class="acts">
          <form method="post" action="/admin/queries/<%= q.id %>/toggle">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-xs" type="submit"><%= q.retired ? 'Resume' : 'Park' %></button>
          </form>
          <% if (!q.retired) { %>
            <form method="post" action="/admin/queries/<%= q.id %>/sweep">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-xs" type="submit" title="Fetch now instead of waiting for the schedule">Sweep</button>
            </form>
          <% } %>
          <% if (q.deletable) { %>
            <form method="post" action="/admin/queries/<%= q.id %>/delete"
              onsubmit="return confirm('Delete this search and the <%= q.tracked %> jobs it remembers? Nobody is watching it. This cannot be undone.')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-xs btn-bad" type="submit"
                title="Only possible because nobody is subscribed">Delete</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  
</div>
