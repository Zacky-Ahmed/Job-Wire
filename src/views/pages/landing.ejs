<%#
  THE HOUR
  ────────
  The page is one hour in the life of a job posting, and scrolling is
  what moves the clock. Every section is a moment inside that hour
  rather than a feature to be listed.

  Non-negotiable, because this page has shipped invisible text before:
  everything here is legible with no JavaScript, no IntersectionObserver
  and no animation support. Motion only ever ADDS — it never reveals.
  Anything that fades in starts visible and is dimmed by script, so a
  browser that runs none of it simply shows the finished page.
%>

<section class="stage hero-stage" id="s-post" data-at="00:00">
  <div class="rail" aria-hidden="true">
    <span class="rail-line"><i id="railFill"></i></span>
    <span class="rail-now" id="railNow">00:00</span>
  </div>

  <canvas class="radar" id="radar" aria-hidden="true"></canvas>

  <div class="stage-in">
    <p class="moment"><span class="moment-t">09:14</span> a posting appears</p>

    <h1 class="mega">
      <span class="mega-l">Somebody</span>
      <span class="mega-l">gets there</span>
      <span class="mega-l"><em>first.</em></span>
    </h1>

    <p class="say">
      It is almost never the best application. It is the one that was
      already open when the posting went up.
    </p>

    <div class="acts">
      <a class="act act-go" href="/signup">Start watching<span aria-hidden="true">→</span></a>
      <a class="act act-quiet" href="/signin">I have an account</a>
    </div>

    <p class="fine">Free. An email address and a keyword is the whole setup.</p>
  </div>

  <%# The live panel: jobs arriving. Rows are present in the markup and
      visible by default; script only staggers their entrance. %>
  <aside class="panel" aria-label="Recent postings caught">
    <header class="panel-top">
      <span class="dot" aria-hidden="true"></span>
      <span class="panel-t">the wire</span>
      <span class="sp"></span>
      <span class="panel-t panel-live">live</span>
    </header>
    <%# Real rows from the live sweep. If the poller ever stops, this
        empties rather than continuing to claim freshness it does not
        have — the page fails the same way the product does. %>
    <ol class="feed">
      <% if (!jobs || !jobs.length) { %>
        <li class="feed-row feed-quiet">
          <span class="feed-age">—</span>
          <span class="feed-role">Nothing caught in the last few minutes</span>
          <span class="feed-co">The sweep runs every 5 minutes, around the clock</span>
        </li>
      <% } %>
      <% (jobs || []).forEach(function (j) { %>
        <li class="feed-row">
          <span class="feed-age"><%= j.age %></span>
          <a class="feed-role" href="/signup">
            <%= j.title %><span class="feed-go" aria-hidden="true">Apply</span></a>
          <span class="feed-co"><%= j.company %><%= j.location ? " · " + j.location : "" %>
  <% if (j.source) { %><span class="feed-src">via <%= j.source %></span><% } %></span>
        </li>
      <% }); %>
    </ol>
    <footer class="panel-foot">
      <span>4 boards swept</span><span class="sp"></span><span>every 5 min</span>
    </footer>
  </aside>
</section>


<%# ── the race ────────────────────────────────────────────────────
    The centre of the page. Not a feature list — the same hour lived
    twice, side by side, with the number that actually decides it. %>
<section class="stage race-stage" id="s-race" data-at="00:31">
  <p class="moment"><span class="moment-t">09:45</span> thirty-one minutes in</p>

  <h2 class="big">The same hour,<br>lived two ways.</h2>

  <%# The pile is drawn, not described. Ninety-four marks against three
      makes the argument before a word of it is read, and the reader can
      count the difference instead of being told it. %>
  <div class="lanes">
    <article class="lane lane-win">
      <p class="lane-k">with a watch running</p>
      <div class="pile pile-win" aria-hidden="true">
        <% for (var i = 0; i < 3; i++) { %><span class="pip pip-you"></span><% } %>
      </div>
      <p class="lane-n"><span class="tally" data-to="3">3</span><span class="lane-u">rd</span>
        <span class="lane-s">in the pile</span></p>
      <ul class="beats">
        <li><b>00:02</b> the email arrives</li>
        <li><b>00:09</b> you have applied</li>
        <li><b>00:31</b> nine people behind you</li>
      </ul>
    </article>

    <article class="lane lane-lose">
      <p class="lane-k">checking once a day</p>
      <div class="pile pile-lose" aria-hidden="true">
        <% for (var j = 0; j < 93; j++) { %><span class="pip"></span><% } %><span class="pip pip-you"></span>
      </div>
      <p class="lane-n"><span class="tally" data-to="94">94</span><span class="lane-u">th</span>
        <span class="lane-s">in the pile</span></p>
      <ul class="beats">
        <li><b>next&nbsp;day</b> you open the tab</li>
        <li><b>+18h</b> the shortlist is drawn</li>
        <li><b>&mdash;</b> nobody reaches your name</li>
      </ul>
    </article>
  </div>

  <p class="say say-wide">
    A real posting from this morning took <b>12 applications in its first
    31 minutes</b>. Recruiters read the pile from the top. Being early is
    not an advantage over the others — it is the thing that decides
    whether you are read at all.
  </p>
</section>


<%# ── the machine ─────────────────────────────────────────────────
    Honest about being infrastructure. Reads like a log, because that
    is what it is. %>
<section class="stage sweep-stage" id="s-sweep" data-at="00:45">
  <p class="moment"><span class="moment-t">every 5 min</span> the sweep</p>

  <h2 class="big">It is awake<br>when you are not.</h2>

  <div class="sweep-grid">
    <ol class="log" aria-label="Example sweep">
      <li><b>06:12:04</b> <span class="log-s">linkedin</span> 61 jobs · <em>+1 new</em></li>
      <li><b>06:12:04</b> <span class="log-s">topjobs</span> 38 jobs</li>
      <li><b>06:12:05</b> <span class="log-s">keells</span> 12 jobs</li>
      <li><b>06:12:05</b> <span class="log-s">mas</span> 64 jobs</li>
      <li class="log-hit"><b>06:12:05</b> match · Intern — Fintech Operations</li>
      <li class="log-out"><b>06:12:06</b> mail → you · 58 min left</li>
    </ol>

    <div class="srcs">
      <p class="srcs-k">where it looks</p>
      <p class="srcs-say">
        Which boards get searched is decided by the country on your watch,
        not by a checkbox you have to understand. Add a board and every
        existing watch reaches it the next time it sweeps.
      </p>
      <ul class="src-list">
        <li><b>LinkedIn</b><span>every country</span></li>
        <li><b>topjobs.lk</b><span>Sri Lanka</span></li>
        <li><b>John Keells</b><span>Sri Lanka</span></li>
        <li><b>MAS Holdings</b><span>Sri Lanka</span></li>
      </ul>
    </div>
  </div>
</section>


<%# ── the honest bit ──────────────────────────────────────────── %>
<section class="stage honest-stage" id="s-honest" data-at="00:58">
  <p class="moment"><span class="moment-t">00:58</span> the part most tools skip</p>

  <h2 class="big">What it<br>cannot do.</h2>

  <div class="owns">
    <article>
      <h3>It cannot beat LinkedIn's own index</h3>
      <p>Measured over 442 postings in a day: the median reaches us
         <b>27 minutes</b> after it goes live, and only about a third
         arrive inside 15. That delay is LinkedIn's public index, not the
         sweep &mdash; jobs simply are not there to fetch yet. The local
         boards have no such lag and reach you within one sweep.</p>
    </article>
    <article>
      <h3>It cannot promise every job</h3>
      <p>Boards go quiet, change their markup and rate-limit. When a
         sweep sees far less than it usually does, that is recorded as a
         fault rather than reported to you as a quiet morning.</p>
    </article>
    <article>
      <h3>It will not apply for you</h3>
      <p>No auto-apply, no generated cover letters. The advantage on
         offer is minutes, not volume — and volume is what makes a pile
         worth skimming in the first place.</p>
    </article>
  </div>
</section>


<%# ── close ───────────────────────────────────────────────────── %>
<section class="stage end-stage" id="s-end" data-at="60:00">
  <p class="moment moment-end"><span class="moment-t">10:14</span> the posting closes</p>

  <h2 class="mega mega-end">
    <span class="mega-l">Be early,</span>
    <span class="mega-l"><em>by default.</em></span>
  </h2>

  <p class="say">
    Set a keyword and a country once. The next hour that matters, you
    will already be in it.
  </p>

  <div class="acts acts-end">
    <a class="act act-go" href="/signup">Start watching<span aria-hidden="true">→</span></a>
    <a class="act act-quiet" href="/signin">Sign in</a>
  </div>
</section>
