<!doctype html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Through asset() like every other file: static assets are served
      immutable for a year in production, so a plain path could never be
      changed once a browser had seen it. %>
  <link rel="icon" href="<%= asset('/favicon.svg') %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="<%= asset('/favicon.svg') %>">
  <title><%= title %></title>
  <meta name="description" content="Job Wire watches job boards for the roles you want and emails you within minutes of one being posted — while the recruiter is still reading.">

  <%# One canonical address for the page. Without it the same landing page
      is reachable at the apex, at www, and at the platform's own
      *.up.railway.app hostname, and a search engine treats those as three
      competing copies rather than one page. %>
  <link rel="canonical" href="<%= siteOrigin %>/">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <% if (locals.googleVerification) { %>
  <%# Search Console ownership. The DNS route verifies the whole domain
      but depends on the registrar saving the record; this one is served
      by the app itself, so it is true the moment it deploys. %>
  <meta name="google-site-verification" content="<%= googleVerification %>">
  <% } %>

  <%# What a link to the site looks like when pasted into WhatsApp,
      LinkedIn or Slack. Without these it renders as a bare grey URL. %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Job Wire">
  <meta property="og:title" content="Job Wire — be early, by default">
  <meta property="og:description" content="Job alerts that arrive in minutes, not tomorrow. Job Wire watches the boards for the roles you want and emails you the moment one appears.">
  <meta property="og:url" content="<%= siteOrigin %>/">
  <meta property="og:image" content="<%= siteOrigin %>/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Job Wire — be early, by default">
  <meta name="twitter:description" content="Job alerts that arrive in minutes, not tomorrow.">
  <meta name="twitter:image" content="<%= siteOrigin %>/og.png">

  <%# Structured data, so the result can carry the product name rather
      than whatever text the crawler happens to pick off the page. %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Job Wire",
    "url": "<%= siteOrigin %>/",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Any",
    "description": "Job Wire watches job boards for the roles you want and emails you within minutes of a new posting.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <link rel="stylesheet" href="<%= asset('/css/app.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/landing.css') %>">
</head>
<body class="lp">
  <header class="lp-nav">
    <a class="wordmark" href="/">
      <span class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"
        stroke-linecap="round"><path d="M12 21v-9"/><path d="M5 12a9 9 0 0 1 14 0" opacity=".55"/>
        <path d="M8.2 15.5a5 5 0 0 1 7.6 0" opacity=".8"/><circle cx="12" cy="8" r="1.8" fill="#fff"/></svg></span>
      <b>Job<span>&nbsp;Wire</span></b>
    </a>
    <span class="sp"></span>
    <button class="btn btn-xs" id="themeBtn" type="button" aria-label="Toggle theme">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a6.8 6.8 0 0 0 11 11Z"/></svg>
      <span id="themeLabel">Dark</span>
    </button>
    <a class="btn btn-xs" href="/signin">Sign in</a>
    <a class="btn btn-xs btn-sig" href="/signup">Start watching</a>
  </header>

  <%- body %>

  <footer class="lp-foot">
    <div class="lp-wrap lp-foot-in">
      <span class="wordmark">
        <span class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"
          stroke-linecap="round"><path d="M12 21v-9"/><path d="M5 12a9 9 0 0 1 14 0" opacity=".55"/>
          <path d="M8.2 15.5a5 5 0 0 1 7.6 0" opacity=".8"/><circle cx="12" cy="8" r="1.8" fill="#fff"/></svg></span>
        <b>Job<span>&nbsp;Wire</span></b>
      </span>
      <p>Built because good applications lose to early ones.</p>
      <nav>
        <a href="/signup">Create an account</a>
        <a href="/signin">Sign in</a>
      </nav>
    </div>
  </footer>

  <script src="<%= asset('/js/theme.js') %>"></script>
  <script src="<%= asset('/js/landing.js') %>"></script>
</body>
</html>
