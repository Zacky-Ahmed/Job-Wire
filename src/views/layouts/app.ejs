<!doctype html>
<html lang="en" data-theme="<%= theme %>"<%- locals.sidebarCollapsed ? ' class="sidebar-collapsed"' : '' %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%# Deliberately NOT through asset(): that appends a content hash that
      changes on every deploy, and Google's favicon crawler caches by
      URL — a moving target never settles. Browsers cache favicons fine
      without it. .ico first because the favicon crawler looks for it. %>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <title><%= title %> · Job Wire</title>
  <%# Behind a login: never index. robots.txt asks crawlers not to
      come here, but a link leaking from anywhere else would still
      put a sign-in redirect in the results. This is the part that
      actually binds. %>
  <meta name="robots" content="noindex,nofollow">
  <link rel="stylesheet" href="<%= asset('/css/app.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/workspace.css') %>">
  <script src="<%= asset('/js/htmx.min.js') %>" defer></script>
</head>
<body class="workspace" hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>
  <a class="skip-link" href="#workspaceMain">Skip to content</a>
  <div class="app">
    <header class="topbar">
      <span class="wordmark">
        <span class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"
          stroke-linecap="round"><path d="M12 21v-9"/><path d="M5 12a9 9 0 0 1 14 0" opacity=".55"/>
          <path d="M8.2 15.5a5 5 0 0 1 7.6 0" opacity=".8"/><circle cx="12" cy="8" r="1.8" fill="#fff"/></svg></span>
        <b>Job<span>&nbsp;Wire</span></b>
      </span>

      <%# Collapses the sidebar to an icon rail. Ships HIDDEN and is
          revealed by script, because a control whose entire behaviour is
          JavaScript should not be offered to a browser that will not run
          it — the same rule the command palette and the theme switch
          already follow. The choice is remembered per browser. %>
      <button class="btn btn-xs sidebar-toggle" id="sidebarToggle" type="button"
        aria-controls="workspaceNav" aria-expanded="true"
        aria-label="Minimize sidebar" title="Minimize sidebar" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="3"/>
          <path d="M9 4v16m6-11-3 3 3 3"/></svg>
      </button>

      <div class="chips">
        <span class="chip"><span class="dot <%= sweeping ? 'live' : 'off' %> live-dot"></span>
          <b><%= sweeping ? 'Sweeping' : (watchCount && !activeCount ? 'All held' : (activeCount ? 'Poller off' : 'Idle')) %></b></span>
        <span class="chip"><span class="k">Watches</span><b><%= activeCount %>/<%= watchCount %></b></span>
        <%# The countdown comes from the server. Deriving it from row
            elements meant it only worked on /watches, so the page people
            actually sit on showed "—" forever. %>
        <span class="chip"><span class="k">Next</span><b class="tnum" id="nextSweep"
          data-next-sweep="<%= typeof nextSweepAt !== 'undefined' && nextSweepAt ? nextSweepAt : '' %>">—</b></span>
      </div>

      <span class="sp"></span>
      <button class="btn btn-xs" id="themeBtn" type="button" aria-label="Toggle theme">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a6.8 6.8 0 0 0 11 11Z"/></svg>
        <span id="themeLabel">Dark</span>
      </button>
      <a class="btn btn-sig btn-xs" href="/watches?new=1"
        hx-boost="true" hx-target="#workspaceMain" hx-swap="innerHTML show:window:top">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg> Watch</a>
      <form method="post" action="/signout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-xs" type="submit" title="Sign out">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round"><path d="M15 17l5-5-5-5M20 12H9"/>
            <path d="M12 20H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6"/></svg></button>
      </form>
    </header>

    <%# Boosted, and ONLY here.

        A blanket hx-boost on <body> would also capture sign-out, every
        row link out to a job board, and the auth pages — links whose
        whole point is to leave this shell. These three places are the
        ones that move between workspace tabs, so these three are what
        get intercepted; everything else stays an ordinary link and
        behaves like one, including with script switched off.

        The target and swap are declared once here and inherited: replace
        the contents of <main>, keep the scroll at the top, and let htmx
        push the real URL so the address bar, bookmarks, and the back
        button all stay honest. %>
    <nav class="tabs" id="workspaceNav" aria-label="Workspace"
      hx-boost="true" hx-target="#workspaceMain" hx-swap="innerHTML show:window:top">
      <span class="nav-caption">WORKSPACE</span>
      <a href="/wire" aria-label="The Wire" title="The Wire" <%- nav === 'wire' ? 'aria-current="page"' : '' %>>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round"><path d="M12 21v-9"/><path d="M5 12a9 9 0 0 1 14 0"/>
          <circle cx="12" cy="8" r="1.5" fill="currentColor"/></svg> <span class="nav-label">The Wire</span></a>
      <a href="/watches" aria-label="Watches" title="Watches" <%- nav === 'watches' ? 'aria-current="page"' : '' %>>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
        <span class="nav-label">Watches</span> <span class="n"><%= watchCount %></span></a>
      <%# Shown only to admins. The route guards itself regardless — a
          hidden link is not access control, it is just tidiness. %>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/admin" aria-label="Admin" title="Admin" <%- nav === 'admin' ? 'aria-current="page"' : '' %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round"><path d="M12 3l7 3v5c0 4.4-2.9 8.3-7 10-4.1-1.7-7-5.6-7-10V6l7-3Z"/></svg>
          <span class="nav-label">Admin</span></a>
      <% } %>
      <span class="sp"></span>
      <span class="me"><%= user.email %></span>
    </nav>

    <%# hx-history-elt scopes back/forward to this element.

        Without it htmx snapshots and restores <body>, so pressing Back
        would tear down and rebuild the header and the sidebar to show a
        page whose header and sidebar had not changed — undoing the whole
        point of swapping only the middle. %>
    <main id="workspaceMain" tabindex="-1" hx-history-elt>
      <%- include('../partials/workspace-heading') %>
      <%- body %>
    </main>
  </div>
  <dialog class="command-dialog" id="commandDialog" aria-labelledby="commandTitle"
    hx-boost="true" hx-target="#workspaceMain" hx-swap="innerHTML show:window:top">
    <div class="command-head"><h2 id="commandTitle">Quick jump</h2><button class="btn btn-xs" id="commandClose" type="button">Close</button></div>
    <p>Go straight to your workspace.</p>
    <a href="/wire">↗ The Wire <span>Explore opportunities</span></a>
    <a href="/watches">◎ Watches <span>Manage your searches</span></a>
    <a href="/watches?new=1">＋ New watch <span>Find your next role</span></a>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %><a href="/admin">◇ Admin <span>Open operations</span></a><% } %>
  </dialog>
  <script src="<%= asset('/js/theme.js') %>"></script>
  <script src="<%= asset('/js/ticker.js') %>"></script>
  <script src="<%= asset('/js/workspace.js') %>"></script>
  <%# Only the new-watch form uses this, but it is loaded here rather than
      from the page. A script tag inside <main> is re-inserted and
      re-evaluated on every navigation to that page; loaded from the shell
      it is fetched once and re-runs itself on swap. %>
  <script src="<%= asset('/js/watch-form.js') %>"></script>
</body>
</html>
